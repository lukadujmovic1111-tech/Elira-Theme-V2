{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.limit
-%}

<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head{% if section.settings.center_heading %} section-head--center{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.show_view_all and collection != blank -%}
        <a href="{{ collection.url }}" class="link-arrow">
          {{ 'collections.general.view_all' | t }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
    </div>

    <div class="product-grid{% if section.settings.columns == 4 %} product-grid--4{% endif %}">
      {%- if collection != blank and collection.products.size > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {%- liquid
            assign load = 'lazy'
            if section.index <= 2 and forloop.index <= 4
              assign load = 'eager'
            endif
          -%}
          {% render 'product-card', card_product: product, loading: load %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <article class="product-card">
            <div class="product-card__media">
              {%- assign ph = 'product-apparel-' | append: forloop.rindex -%}
              {{ ph | placeholder_svg_tag: 'product-card__placeholder' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">{{ 'onboarding.product_title' | t }}</h3>
              <div class="price"><span>{{ 4990 | money }}</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (kleine Zeile)",
      "default": "Elira Pilates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Unsere Bestseller"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Überschrift zentrieren",
      "default": false
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kollektion"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Anzahl Produkte",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 4,
      "step": 1,
      "label": "Spalten (Desktop)",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "„Alle ansehen“-Link zeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
