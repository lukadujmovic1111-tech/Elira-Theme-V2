<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="duo-grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_url = block.settings.link
          if card_url == blank and block.settings.collection != blank
            assign card_url = block.settings.collection.url
          endif
          assign card_image = block.settings.image
          if card_image == blank and block.settings.collection.image
            assign card_image = block.settings.collection.image
          endif
        -%}
        <a href="{{ card_url | default: '#' }}" class="editorial-card" {{ block.shopify_attributes }}>
          <div class="editorial-card__media">
            {%- if card_image -%}
              {{ card_image | image_url: width: 1400 | image_tag:
                widths: '550, 750, 1100, 1400',
                sizes: '(min-width: 750px) 50vw, 100vw',
                loading: 'lazy',
                alt: block.settings.heading
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <div class="editorial-card__content">
            {%- if block.settings.badge != blank -%}
              <span class="badge hero__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <h3 class="editorial-card__title h3">{{ block.settings.heading }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="editorial-card__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.cta != blank -%}
              <span class="link-arrow">
                {{ block.settings.cta }}
                {% render 'icon', icon: 'arrow-right' %}
              </span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Editorial-Karten",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Karte",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Fallback: Bild der gewählten Kollektion."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion (für Link & Bild)"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Outfits"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "Link-Text",
          "default": "Jetzt shoppen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (überschreibt Kollektion)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Editorial-Karten",
      "blocks": [
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
