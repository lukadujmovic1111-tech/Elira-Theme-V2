<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div class="testimonial-grid">
      {%- for block in section.blocks -%}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          {%- if block.settings.stars > 0 -%}
            <div class="testimonial__stars" aria-label="{{ 'general.accessibility.star_rating' | t: rating: block.settings.stars }}">
              {%- for i in (1..block.settings.stars) -%}
                {% render 'icon', icon: 'star' %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          <blockquote class="testimonial__quote">{{ block.settings.quote }}</blockquote>
          <figcaption class="testimonial__author">{{ block.settings.author }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Community"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Was unsere Kundinnen sagen"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 6,
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 0,
          "max": 5,
          "step": 1,
          "label": "Sterne",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Zitat",
          "default": "Das weichste Set, das ich je getragen habe – sitzt perfekt, auch nach zehn Wäschen."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name",
          "default": "Lena M. – Verifizierte Käuferin"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "quote": "Das weichste Set, das ich je getragen habe – sitzt perfekt, auch nach zehn Wäschen.",
            "author": "Lena M. – Verifizierte Käuferin"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Endlich Pilates-Wear, die im Studio UND beim Brunch funktioniert. Bin verliebt.",
            "author": "Sophie K. – Verifizierte Käuferin"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "quote": "Der Widerstandsring ist mein tägliches Must-have geworden. Qualität spürt man sofort.",
            "author": "Anna R. – Verifizierte Käuferin"
          }
        }
      ]
    }
  ]
}
{% endschema %}
