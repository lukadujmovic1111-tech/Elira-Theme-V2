<div class="password-box">
  <span class="header__wordmark">{{ shop.name | split: ' ' | first }}</span>
  <h1 class="h2">{{ section.settings.heading }}</h1>
  {%- if section.settings.text != blank -%}
    <p class="text-soft">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="form-status form-status--error" role="alert">{{ 'general.password_page.error' | t }}</p>
    {%- endif -%}
    <div class="newsletter-form">
      <input
        type="password"
        name="password"
        placeholder="{{ 'general.password_page.password' | t }}"
        aria-label="{{ 'general.password_page.password' | t }}"
        required
      >
      <button type="submit">
        {{ 'general.password_page.submit' | t }}
        {% render 'icon', icon: 'arrow-right' %}
      </button>
    </div>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Passwort-Seite",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bald geht's los"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Wir arbeiten gerade an etwas Schönem. Trag dich im Newsletter ein und erfahre als Erste davon."
    }
  ]
}
{% endschema %}
