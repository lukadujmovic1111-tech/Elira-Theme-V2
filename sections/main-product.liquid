<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="pdp">
      <product-gallery class="pdp__gallery">
        <div class="pdp__gallery-stack">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="pdp__media-item" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {%- liquid
                      assign load = 'lazy'
                      if forloop.index <= 2
                        assign load = 'eager'
                      endif
                      assign media_alt = media.alt | default: product.title
                    -%}
                    {{ media | image_url: width: 1400 | image_tag:
                      widths: '550, 750, 1100, 1400, 1800',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      loading: load,
                      alt: media_alt
                    }}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, muted: true, loop: true, style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: style: 'position:absolute;inset:0;width:100%;height:100%;border:0;' }}
                  {%- else -%}
                    {{ media.preview_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="pdp__media-item">
              {{ 'product-apparel-1' | placeholder_svg_tag: 'product-card__placeholder' }}
            </div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="pdp__counter" aria-hidden="true">
            <span data-gallery-current>1</span> / {{ product.media.size }}
          </div>
        {%- endif -%}
      </product-gallery>

      <div class="pdp__info">
        {%- assign current_variant = product.selected_or_first_available_variant -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'title' -%}
              <div {{ block.shopify_attributes }}>
                {%- if block.settings.show_vendor and product.vendor != blank -%}
                  <p class="eyebrow pdp__vendor">{{ product.vendor }}</p>
                {%- endif -%}
                <h1 class="pdp__title h2">{{ product.title }}</h1>
              </div>

            {%- when 'price' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'price', product: product, use_variant: current_variant, class: 'price--large' %}
                <p class="pdp__tax-note" style="margin-top: 0.4rem;">{{ 'products.product.tax_note' | t }}</p>
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign position0 = forloop.index0
                      assign opt_name_down = option.name | downcase
                      assign is_color = false
                      if opt_name_down == 'farbe' or opt_name_down == 'color' or opt_name_down == 'colour'
                        if block.settings.show_swatches
                          assign is_color = true
                        endif
                      endif
                    -%}
                    <fieldset class="pdp__option">
                      <legend class="pdp__option-label">
                        {{ option.name }}
                        <span class="pdp__option-value" data-option-value-label>{{ option.selected_value }}</span>
                      </legend>
                      <div class="pdp__option-values">
                        {%- for value in option.values -%}
                          {%- if is_color -%}
                            {%- capture swatch_color -%}{% render 'swatch-color', value: value %}{%- endcapture -%}
                            <label class="opt-swatch" title="{{ value | escape }}">
                              <input
                                type="radio"
                                name="option-{{ section.id }}-{{ position0 }}"
                                value="{{ value | escape }}"
                                data-option-position="{{ position0 }}"
                                {% if value == option.selected_value %}checked{% endif %}
                              >
                              <span style="--swatch: {{ swatch_color | strip }};"></span>
                              <span class="visually-hidden">{{ value }}</span>
                            </label>
                          {%- else -%}
                            <label class="opt-pill">
                              <input
                                type="radio"
                                name="option-{{ section.id }}-{{ position0 }}"
                                value="{{ value | escape }}"
                                data-option-position="{{ position0 }}"
                                {% if value == option.selected_value %}checked{% endif %}
                              >
                              <span>{{ value }}</span>
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}

                  <script type="application/json">
                    [
                      {%- for variant in product.variants -%}
                        {
                          "id": {{ variant.id }},
                          "available": {{ variant.available }},
                          "options": {{ variant.options | json }},
                          "price": {{ variant.price | money | json }},
                          "compare_at": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                          "media_index": {% if variant.featured_media %}{{ variant.featured_media.position | minus: 1 }}{% else %}null{% endif %}
                        }{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    ]
                  </script>
                </variant-picker>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <product-form {{ block.shopify_attributes }}>
                {%- form 'product', product, class: 'pdp__buy', novalidate: 'novalidate' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}">

                  {%- if block.settings.show_quantity -%}
                    <div class="pdp__option">
                      <span class="pdp__option-label">{{ 'products.product.quantity' | t }}</span>
                      {% render 'quantity-input', name: 'quantity', value: 1 %}
                    </div>
                  {%- endif -%}

                  <div class="pdp__buy-row">
                    <button
                      type="submit"
                      name="add"
                      class="btn btn--full"
                      data-atc
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </button>
                  </div>

                  {%- if block.settings.show_dynamic_checkout -%}
                    {{ form | payment_button }}
                  {%- endif -%}
                {%- endform -%}
              </product-form>

            {%- when 'usp' -%}
              <ul class="pdp__usps" {{ block.shopify_attributes }}>
                {%- if block.settings.text_1 != blank -%}
                  <li>{% render 'icon', icon: 'truck' %}{{ block.settings.text_1 }}</li>
                {%- endif -%}
                {%- if block.settings.text_2 != blank -%}
                  <li>{% render 'icon', icon: 'return' %}{{ block.settings.text_2 }}</li>
                {%- endif -%}
                {%- if block.settings.text_3 != blank -%}
                  <li>{% render 'icon', icon: 'shield' %}{{ block.settings.text_3 }}</li>
                {%- endif -%}
              </ul>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                {%- liquid
                  assign desc_heading = block.settings.heading
                  if desc_heading == blank
                    assign desc_heading = 'products.product.description' | t
                  endif
                -%}
                <div class="accordion" {{ block.shopify_attributes }}>
                  <details class="accordion__item" {% if block.settings.open %}open{% endif %}>
                    <summary class="accordion__summary">
                      {{ desc_heading }}
                      {% render 'icon', icon: 'chevron-down' %}
                    </summary>
                    <div class="accordion__content rte">{{ product.description }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'accordion' -%}
              {%- if block.settings.content != blank -%}
                <div class="accordion" style="border-top: none; margin-top: -1.25rem;" {{ block.shopify_attributes }}>
                  <details class="accordion__item">
                    <summary class="accordion__summary">
                      {{ block.settings.heading }}
                      {% render 'icon', icon: 'chevron-down' %}
                    </summary>
                    <div class="accordion__content rte">{{ block.settings.content }}</div>
                  </details>
                </div>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="rte text-soft" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}

          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Produktseite",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "Titel",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_vendor",
          "label": "Marke anzeigen",
          "default": false
        }
      ]
    },
    {
      "type": "price",
      "name": "Preis",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variantenwahl",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_swatches",
          "label": "Farb-Swatches anzeigen",
          "default": true
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Kauf-Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_quantity",
          "label": "Mengenwahl anzeigen",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Dynamische Checkout-Buttons",
          "default": true
        }
      ]
    },
    {
      "type": "usp",
      "name": "USP-Liste",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text_1",
          "label": "Zeile 1",
          "default": "Kostenloser Versand ab 75 €"
        },
        {
          "type": "text",
          "id": "text_2",
          "label": "Zeile 2",
          "default": "30 Tage Rückgaberecht"
        },
        {
          "type": "text",
          "id": "text_3",
          "label": "Zeile 3",
          "default": "Sichere Zahlung & Käuferschutz"
        }
      ]
    },
    {
      "type": "description",
      "name": "Beschreibung (Akkordeon)",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": true
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Akkordeon",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Material & Pflege"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Inhalt",
          "default": "<p>78 % Polyamid, 22 % Elasthan. Bei 30 °C im Schonwaschgang waschen, nicht trocknergeeignet.</p>"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ]
}
{% endschema %}
