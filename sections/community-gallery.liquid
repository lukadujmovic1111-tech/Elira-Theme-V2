<section class="section community-gallery">
  <div class="container container--wide">
    <div class="section-head section-head--center" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-sub">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="community-gallery__slider" data-reveal data-community-slider>
    <button type="button" class="community-gallery__nav community-gallery__nav--prev" data-community-prev aria-label="Vorherige Bilder">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>

    <div class="community-gallery__track" data-community-track>
      {%- for block in section.blocks -%}
        {%- liquid
          assign pidx = forloop.index0 | modulo: 4 | plus: 1
          assign tile_url = block.settings.link
          if tile_url == blank and settings.social_instagram != blank
            assign tile_url = settings.social_instagram
          endif
        -%}
        <a href="{{ tile_url | default: '#' }}" class="community-tile" {{ block.shopify_attributes }}{% if block.settings.link == blank %} target="_blank" rel="noopener"{% endif %}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image
              | image_url: width: 800
              | image_tag:
                widths: '300, 500, 800',
                sizes: '(min-width: 990px) 20vw, 44vw',
                loading: 'lazy' }}
          {%- else -%}
            {{ 'collection-apparel-' | append: pidx | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="community-tile__overlay">
            {% render 'icon', name: 'instagram', size: 22 %}
            {%- if block.settings.caption != blank -%}
              <span class="community-tile__caption">{{ block.settings.caption }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>

    <button type="button" class="community-gallery__nav community-gallery__nav--next" data-community-next aria-label="Weitere Bilder">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>

  {%- if section.settings.handle != blank -%}
    <div class="community-gallery__cta" data-reveal>
      <a href="{{ settings.social_instagram | default: '#' }}" class="btn btn--secondary" target="_blank" rel="noopener">
        {% render 'icon', name: 'instagram', size: 16 %}
        {{ section.settings.handle }}
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.community-gallery__slider {
  position: relative;
  margin-top: 2.5rem;
}
.community-gallery__track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding: 0 5vw 0.5rem;
  scrollbar-width: none;
}
.community-gallery__track::-webkit-scrollbar { display: none; }
.community-gallery__track > .community-tile {
  flex: 0 0 auto;
  width: 44vw;
  max-width: 360px;
  scroll-snap-align: start;
  aspect-ratio: 1 / 1;
}
.community-gallery__track > .community-tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (min-width: 750px) {
  .community-gallery__track > .community-tile { width: 30vw; }
}
@media (min-width: 990px) {
  .community-gallery__track { padding: 0 3vw 0.5rem; }
  .community-gallery__track > .community-tile { width: 20vw; max-width: 300px; }
}
.community-gallery__nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 999px;
  border: 1px solid rgba(0, 0, 0, 0.08);
  background: #fff;
  color: #1a1a1a;
  cursor: pointer;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
  transition: opacity .2s ease, transform .2s ease;
}
.community-gallery__nav:hover { transform: translateY(-50%) scale(1.05); }
.community-gallery__nav--prev { left: 1rem; }
.community-gallery__nav--next { right: 1rem; }
.community-gallery__nav[disabled] { opacity: 0; pointer-events: none; }
@media (min-width: 990px) {
  .community-gallery__nav { display: inline-flex; }
}
{% endstylesheet %}

<script>
  (function () {
    function initCommunitySlider(slider) {
      if (slider.dataset.communityReady === 'true') return;
      slider.dataset.communityReady = 'true';
      var track = slider.querySelector('[data-community-track]');
      var prev = slider.querySelector('[data-community-prev]');
      var next = slider.querySelector('[data-community-next]');
      if (!track) return;
      function step() {
        var tile = track.querySelector('.community-tile');
        var tileW = tile ? tile.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
        return Math.max(tileW, track.clientWidth * 0.8);
      }
      function update() {
        var maxScroll = track.scrollWidth - track.clientWidth - 1;
        if (prev) prev.disabled = track.scrollLeft <= 0;
        if (next) next.disabled = track.scrollLeft >= maxScroll;
      }
      if (prev) prev.addEventListener('click', function () { track.scrollBy({ left: -step(), behavior: 'smooth' }); });
      if (next) next.addEventListener('click', function () { track.scrollBy({ left: step(), behavior: 'smooth' }); });
      track.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
      update();
    }
    function initAll() {
      document.querySelectorAll('[data-community-slider]').forEach(initCommunitySlider);
    }
    if (document.readyState !== 'loading') initAll();
    else document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "Community / Instagram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "#EliraMoves"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Getragen von unserer Community"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Zeig uns deinen Flow und werde Teil der Elira-Community."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Button-Text",
      "default": "@elira folgen"
    }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Empfohlen: quadratisch, 800 × 800 px"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional, sonst Instagram-Profil)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community / Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
