<aside id="CartDrawer" class="drawer drawer--right" aria-hidden="true" role="dialog" aria-label="{{ 'cart.title' | t }}">
  <div id="CartDrawerShell" class="cart-drawer-shell drawer__shell" data-item-count="{{ cart.item_count }}">
    <div class="drawer__head">
      <p class="drawer__title h5">
        {{ 'cart.title' | t }}
        {%- if cart.item_count > 0 -%}
          &nbsp;({{ cart.item_count }})
        {%- endif -%}
      </p>
      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="drawer__body">
        <div class="cart-empty">
          <p class="h4">{{ 'cart.empty' | t }}</p>
          <a href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}" class="btn" data-drawer-close>
            {{ 'cart.empty_cta' | t }}
          </a>
        </div>
      </div>
    {%- else -%}
      <div class="drawer__body">
        {%- if settings.show_free_shipping_bar and settings.free_shipping_threshold > 0 -%}
          {%- liquid
            assign threshold = settings.free_shipping_threshold | times: 100
            assign remaining = threshold | minus: cart.total_price
            assign progress = cart.total_price | times: 100.0 | divided_by: threshold | at_most: 100
          -%}
          <div class="free-shipping" style="--progress: {{ progress }}%;">
            {%- if remaining > 0 -%}
              {%- assign remaining_formatted = remaining | money -%}
              <p>{{ 'cart.free_shipping_remaining_html' | t: amount: remaining_formatted }}</p>
            {%- else -%}
              <p><strong>{{ 'cart.free_shipping_unlocked' | t }}</strong></p>
            {%- endif -%}
            <div class="free-shipping__bar"><div class="free-shipping__progress"></div></div>
          </div>
        {%- endif -%}

        <div class="cart-drawer__lines">
          {%- for item in cart.items -%}
            <div class="cart-line">
              <a href="{{ item.url }}" class="cart-line__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: widths: '120, 240', sizes: '88px', loading: 'lazy', alt: item.title }}
                {%- else -%}
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                {%- endif -%}
              </a>
              <div class="cart-line__details">
                <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-line__variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                {%- for discount in item.line_level_discount_allocations -%}
                  <p class="cart-line__variant">{{ discount.discount_application.title }}</p>
                {%- endfor -%}
                <div class="cart-line__price-row">
                  <div class="price">
                    {%- if item.original_line_price > item.final_line_price -%}
                      <span class="price__sale">{{ item.final_line_price | money }}</span>
                      <s class="price__compare">{{ item.original_line_price | money }}</s>
                    {%- else -%}
                      <span>{{ item.final_line_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <div class="cart-line__controls">
                  {% render 'quantity-input', value: item.quantity, line: forloop.index, small: true %}
                  <button type="button" class="cart-line__remove" data-line-remove="{{ forloop.index }}">
                    {{ 'cart.remove' | t }}
                  </button>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="drawer__footer">
        <div class="cart-totals">
          <div class="cart-totals__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money }}</strong>
          </div>
          <p class="cart-page__shipping-note">{{ 'cart.shipping_note' | t }}</p>
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--full">{{ 'cart.checkout' | t }}</button>
          </form>
          <a href="{{ routes.cart_url }}" class="link-underline" style="align-self: center; font-size: 0.8rem;">{{ 'cart.view' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</aside>

{% schema %}
{
  "name": "Warenkorb-Drawer",
  "tag": "div",
  "settings": [
    {
      "type": "url",
      "id": "empty_link",
      "label": "Link für „Jetzt shoppen“ (leerer Warenkorb)"
    }
  ]
}
{% endschema %}
