{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign per_page = section.settings.per_page
-%}

{%- if section.settings.show_banner -%}
  <div class="collection-banner">
    <div class="container">
      <span class="eyebrow">{{ 'collections.list.title' | t }}</span>
      <h1 class="h1" style="margin-top: 0.5rem;">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection-banner__desc rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

<div class="section" style="--pt: 0px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- paginate collection.products by per_page -%}

      <div class="collection-toolbar">
        <p class="collection-toolbar__count">
          {{ 'collections.general.product_count.other' | t: count: collection.products_count }}
        </p>

        <div class="collection-toolbar__actions">
          {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
            <button type="button" class="collection-toolbar__filter-btn" data-drawer-trigger="FilterDrawer">
              {% render 'icon', icon: 'filter' %}
              {{ 'collections.filters.title' | t }}
            </button>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <div class="select-wrap">
              <select data-sort-select aria-label="{{ 'collections.sorting.title' | t }}">
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
              {% render 'icon', icon: 'chevron-down' %}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- liquid
        assign has_active_filters = false
        for filter in collection.filters
          if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
            assign has_active_filters = true
          endif
        endfor
      -%}

      {%- if has_active_filters -%}
        <div class="active-filters">
          {%- for filter in collection.filters -%}
            {%- for active_value in filter.active_values -%}
              <a class="active-filters__chip" href="{{ active_value.url_to_remove }}">
                {{ filter.label }}: {{ active_value.label }}
                {% render 'icon', icon: 'close' %}
              </a>
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value or filter.max_value.value -%}
                <a class="active-filters__chip" href="{{ filter.url_to_remove }}">
                  {{ filter.label }}
                  {% render 'icon', icon: 'close' %}
                </a>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <a class="active-filters__clear" href="{{ collection.url }}?sort_by={{ sort_by }}">
            {{ 'collections.general.clear_all' | t }}
          </a>
        </div>
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <div class="product-grid{% if section.settings.columns == 4 %} product-grid--4{% endif %}">
          {%- for product in collection.products -%}
            {%- liquid
              assign load = 'lazy'
              if forloop.index <= 4
                assign load = 'eager'
              endif
            -%}
            {% render 'product-card', card_product: product, loading: load %}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="collection-empty">
          <p class="h3">{{ 'collections.general.empty' | t }}</p>
          {%- if has_active_filters -%}
            <p class="text-soft">{{ 'collections.general.empty_filtered' | t }}</p>
            <a href="{{ collection.url }}" class="btn btn--outline">{{ 'collections.general.clear_all' | t }}</a>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline">{{ 'collections.general.view_all' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} Filter-Drawer {%- endcomment -%}
      {%- if section.settings.enable_filters and collection.filters.size > 0 -%}
        <aside id="FilterDrawer" class="drawer drawer--left" aria-hidden="true" role="dialog" aria-label="{{ 'collections.filters.title' | t }}">
          <facet-form style="display: contents;">
            <form action="{{ collection.url }}" method="get" style="display: contents;">
              <input type="hidden" name="sort_by" value="{{ sort_by }}">
              <div class="drawer__head">
                <p class="drawer__title h5">{{ 'collections.filters.filter_and_sort' | t }}</p>
                <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'general.accessibility.close' | t }}">
                  {% render 'icon', icon: 'close' %}
                </button>
              </div>
              <div class="drawer__body">
                {%- for filter in collection.filters -%}
                  <details class="facet-group" {% if filter.active_values.size > 0 or forloop.first %}open{% endif %}>
                    <summary class="facet-group__summary">
                      {{ filter.label }}
                      {% render 'icon', icon: 'chevron-down' %}
                    </summary>
                    <div class="facet-group__content">
                      {%- case filter.type -%}
                        {%- when 'boolean', 'list' -%}
                          {%- for value in filter.values -%}
                            <label class="facet-check{% if value.count == 0 and value.active == false %} facet-check--disabled{% endif %}">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                {% if value.count == 0 and value.active == false %}disabled{% endif %}
                              >
                              <span>{{ value.label }}</span>
                              <span class="facet-check__count">({{ value.count }})</span>
                            </label>
                          {%- endfor -%}
                        {%- when 'price_range' -%}
                          {%- assign max_price = filter.range_max | divided_by: 100.0 | ceil -%}
                          <div class="facet-price">
                            <div class="field">
                              <label class="field__label" for="FilterMin">{{ 'collections.filters.from' | t }}</label>
                              <input
                                class="field__input"
                                id="FilterMin"
                                type="number"
                                name="{{ filter.min_value.param_name }}"
                                min="0"
                                max="{{ max_price }}"
                                placeholder="0"
                                {% if filter.min_value.value %}value="{{ filter.min_value.value | divided_by: 100 }}"{% endif %}
                              >
                            </div>
                            <div class="field">
                              <label class="field__label" for="FilterMax">{{ 'collections.filters.to' | t }}</label>
                              <input
                                class="field__input"
                                id="FilterMax"
                                type="number"
                                name="{{ filter.max_value.param_name }}"
                                min="0"
                                max="{{ max_price }}"
                                placeholder="{{ max_price }}"
                                {% if filter.max_value.value %}value="{{ filter.max_value.value | divided_by: 100 }}"{% endif %}
                              >
                            </div>
                          </div>
                      {%- endcase -%}
                    </div>
                  </details>
                {%- endfor -%}
              </div>
              <div class="drawer__footer">
                <button type="submit" class="btn btn--full">{{ 'collections.filters.apply' | t }}</button>
              </div>
            </form>
          </facet-form>
        </aside>
      {%- endif -%}

    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Kollektionsseite",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Banner mit Titel anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "Filter aktivieren",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Sortierung aktivieren",
      "default": true
    },
    {
      "type": "range",
      "id": "per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "label": "Produkte pro Seite",
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "min": 3,
      "max": 4,
      "step": 1,
      "label": "Spalten (Desktop)",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    }
  ]
}
{% endschema %}
