<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="section-head section-head--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-head__sub" style="margin-top: 0.6rem;">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="gallery-row" style="--gal-cols: {{ section.blocks.size | at_least: 2 | at_most: 6 }};">
    {%- for block in section.blocks -%}
      {%- liquid
        assign tag_el = 'div'
        if block.settings.link != blank
          assign tag_el = 'a'
        endif
      -%}
      <{{ tag_el }}{% if block.settings.link != blank %} href="{{ block.settings.link }}"{% endif %} class="gallery-row__item" {{ block.shopify_attributes }}>
        {%- assign gal_alt = section.settings.heading | default: shop.name -%}
        {%- if block.settings.image -%}
          {{ block.settings.image | image_url: width: 720 | image_tag:
            widths: '360, 540, 720',
            sizes: '(min-width: 750px) 20vw, 50vw',
            loading: 'lazy',
            alt: gal_alt
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
      </{{ tag_el }}>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Lifestyle-Galerie",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "@elirapilates"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Elira + Du"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Zeig uns deinen Flow – tagge @elirapilates und werde Teil der Community."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Bild",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lifestyle-Galerie",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
