<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="page-hero" style="padding-top: 0;">
      <h1 class="h1">{{ 'collections.list.title' | t }}</h1>
    </div>

    {%- paginate collections by 12 -%}
      <div class="collection-list-grid">
        {%- for collection in collections -%}
          <a href="{{ collection.url }}" class="category-card">
            <div class="category-card__media">
              {%- if collection.image -%}
                {{ collection.image | image_url: width: 900 | image_tag:
                  widths: '450, 675, 900',
                  sizes: '(min-width: 990px) 33vw, 50vw',
                  loading: 'lazy',
                  alt: collection.title
                }}
              {%- elsif collection.products.first.featured_media -%}
                {{ collection.products.first.featured_media | image_url: width: 900 | image_tag:
                  widths: '450, 675, 900',
                  sizes: '(min-width: 990px) 33vw, 50vw',
                  loading: 'lazy',
                  alt: collection.title
                }}
              {%- else -%}
                {{ 'collection-3' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <span class="category-card__label">
              {{ collection.title }}
              {% render 'icon', icon: 'arrow-right' %}
            </span>
          </a>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</div>

{% schema %}
{
  "name": "Kollektionsliste",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    }
  ]
}
{% endschema %}
