<div class="hero hero--h-{{ section.settings.height }}" style="--hero-shade: {{ section.settings.shade }};">
  <div class="hero__media">
    {%- assign hero_alt = section.settings.heading | default: shop.name -%}
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
        widths: '750, 1100, 1500, 1900, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: hero_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero__content{% if section.settings.alignment == 'center' %} hero__content--center{% endif %}">
    {%- if section.settings.badge != blank -%}
      <span class="badge hero__badge anim-fade-up">{{ section.settings.badge }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading h1 anim-fade-up" style="animation-delay: 0.08s;">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__sub anim-fade-up" style="animation-delay: 0.16s;">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
      <div class="hero__actions anim-fade-up" style="animation-delay: 0.24s;">
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--light">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--outline" style="color: #FCF9F5;">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Empfohlen: 2400 × 1400 px"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Höhe",
      "options": [
        { "value": "full", "label": "Volle Höhe" },
        { "value": "large", "label": "Groß" },
        { "value": "medium", "label": "Mittel" }
      ],
      "default": "large"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "options": [
        { "value": "left", "label": "Links unten" },
        { "value": "center", "label": "Zentriert" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "shade",
      "min": 0,
      "max": 60,
      "step": 5,
      "label": "Abdunklung",
      "default": 30
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Jetzt erhältlich"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Die Studio Kollektion"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Pilates-Wear, die mit jeder Bewegung mitgeht – entworfen für Studio, Stadt und Sofa."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button 1 – Text",
      "default": "Jetzt entdecken"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button 1 – Link"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "Button 2 – Text"
    },
    {
      "type": "url",
      "id": "cta2_link",
      "label": "Button 2 – Link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
