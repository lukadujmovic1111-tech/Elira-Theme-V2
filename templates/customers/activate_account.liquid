<div class="customer-page">
  <div class="customer-page__head">
    <h1 class="h1">{{ 'customer.activate_account.title' | t }}</h1>
    <p>{{ 'customer.activate_account.subtext' | t }}</p>
  </div>

  {%- form 'activate_customer_password' -%}
    {%- if form.errors -%}
      <div class="form-status form-status--error" role="alert">
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}

    <div class="field">
      <label class="field__label" for="ActivatePassword">{{ 'customer.activate_account.password' | t }}</label>
      <input class="field__input" type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password" required>
    </div>

    <div class="field">
      <label class="field__label" for="ActivatePasswordConfirm">{{ 'customer.activate_account.password_confirm' | t }}</label>
      <input class="field__input" type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" autocomplete="new-password" required>
    </div>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
      <button type="submit" class="btn btn--full">{{ 'customer.activate_account.submit' | t }}</button>
      <button type="submit" class="btn btn--outline btn--full" name="decline">{{ 'customer.activate_account.cancel' | t }}</button>
    </div>
  {%- endform -%}
</div>
