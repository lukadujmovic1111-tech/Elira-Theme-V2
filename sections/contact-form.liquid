<div class="section" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container container--narrow">
    <div class="page-hero" style="padding-top: 0;">
      <h1 class="h1">{{ section.settings.heading | default: page.title }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="page-hero__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <p class="form-status form-status--success" role="status">{{ 'contact.form.post_success' | t }}</p>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error" role="alert">
          <p>{{ 'contact.form.error_heading' | t }}</p>
          <ul>
            {%- for field in form.errors -%}
              <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div style="display: flex; flex-direction: column; gap: 1.1rem;">
        <div class="form-row">
          <div class="field">
            <label class="field__label" for="ContactName">{{ 'contact.form.name' | t }}</label>
            <input class="field__input" id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name" required>
          </div>
          <div class="field">
            <label class="field__label" for="ContactEmail">{{ 'contact.form.email' | t }}</label>
            <input class="field__input" id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
          </div>
        </div>
        <div class="field">
          <label class="field__label" for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input class="field__input" id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>
        <div class="field">
          <label class="field__label" for="ContactBody">{{ 'contact.form.message' | t }}</label>
          <textarea class="field__input" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
        </div>
        <button type="submit" class="btn">{{ 'contact.form.send' | t }}</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Kontaktformular",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Schreib uns"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Untertitel",
      "default": "Wir antworten in der Regel innerhalb von 24 Stunden – Montag bis Freitag."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Kontaktformular"
    }
  ]
}
{% endschema %}
