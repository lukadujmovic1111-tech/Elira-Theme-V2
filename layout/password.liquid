<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <title>{{ shop.name }}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {%- liquid
    assign body_font = settings.type_body_font
    assign heading_font = settings.type_header_font
  -%}

  <style>
    {{ body_font | font_face: font_display: 'swap' }}
    {{ heading_font | font_face: font_display: 'swap' }}

    :root {
      --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
      --font-body-weight: {{ body_font.weight | default: 400 }};
      --font-body-weight-bold: 600;
      --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
      --font-heading-weight: {{ heading_font.weight | default: 500 }};
      --color-bg: {{ settings.color_background }};
      --color-surface: {{ settings.color_surface }};
      --color-ink: {{ settings.color_text }};
      --color-accent: {{ settings.color_accent }};
      --color-sale: {{ settings.color_sale }};
      --color-btn: {{ settings.color_button }};
      --color-btn-text: {{ settings.color_button_text }};
      --page-width: {{ settings.page_width }}px;
      --radius-btn: {{ settings.button_radius }}px;
      --radius-card: {{ settings.card_radius }}px;
      --body-size: {{ settings.body_size }}px;
      --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
      --card-aspect: 3 / 4;
    }
  </style>

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>

<body class="template-password">
  <main id="MainContent" class="main-content password-main" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
