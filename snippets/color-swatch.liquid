{%- comment -%}
  Gibt den CSS-Hintergrund für einen Farbnamen aus (deutsch + englisch).
  Parameter: value (Farbname als String)
  Ausgabe: style-Wert, z. B. "#1B1A18" oder ein Gradient.
{%- endcomment -%}
{%- liquid
  assign v = value | downcase | strip
  assign bg = ''

  case v
    when 'schwarz', 'black', 'onyx'
      assign bg = '#1d1c1a'
    when 'weiß', 'weiss', 'white', 'ivory', 'elfenbein'
      assign bg = '#f7f6f3'
    when 'creme', 'cream', 'ecru', 'vanilla', 'vanille'
      assign bg = '#efe9dd'
    when 'sand', 'beige', 'oat', 'hafer'
      assign bg = '#d9cdb8'
    when 'taupe', 'greige'
      assign bg = '#b3a695'
    when 'mokka', 'mocha', 'kakao', 'cocoa'
      assign bg = '#8a6f5c'
    when 'espresso', 'braun', 'brown', 'schoko'
      assign bg = '#5b4636'
    when 'salbei', 'sage', 'salbeigrün'
      assign bg = '#a8b39a'
    when 'olive', 'oliv', 'olivgrün'
      assign bg = '#74785a'
    when 'tanne', 'forest', 'dunkelgrün', 'pine'
      assign bg = '#3d4f42'
    when 'mint', 'minze'
      assign bg = '#cfe0d4'
    when 'eukalyptus', 'eucalyptus'
      assign bg = '#9eb5a6'
    when 'rosé', 'rose', 'rosa', 'pink', 'blush'
      assign bg = '#e8c9c6'
    when 'altrosa', 'dusty rose', 'mauve'
      assign bg = '#c79f9d'
    when 'terracotta', 'terrakotta', 'clay', 'rust'
      assign bg = '#b3674c'
    when 'bordeaux', 'burgundy', 'wein', 'wine', 'cherry'
      assign bg = '#6e2e35'
    when 'rot', 'red'
      assign bg = '#b03a2e'
    when 'koralle', 'coral', 'peach', 'pfirsich'
      assign bg = '#e8a087'
    when 'lavendel', 'lavender', 'flieder', 'lilac'
      assign bg = '#c5bcd6'
    when 'pflaume', 'plum', 'aubergine'
      assign bg = '#5d4157'
    when 'himmelblau', 'sky', 'sky blue', 'hellblau'
      assign bg = '#b9cfdd'
    when 'blau', 'blue', 'kobalt', 'cobalt'
      assign bg = '#39598f'
    when 'navy', 'marine', 'dunkelblau', 'mitternacht', 'midnight'
      assign bg = '#232c3d'
    when 'petrol', 'teal'
      assign bg = '#2f5d62'
    when 'grau', 'grey', 'gray'
      assign bg = '#9a9a96'
    when 'hellgrau', 'heather grey', 'graumeliert'
      assign bg = '#c9c9c5'
    when 'anthrazit', 'charcoal', 'graphit', 'graphite'
      assign bg = '#46464a'
    when 'silber', 'silver'
      assign bg = '#c7c9cc'
    when 'gold'
      assign bg = '#c9a96a'
    when 'senf', 'mustard', 'ocker', 'ochre'
      assign bg = '#c2913e'
    when 'gelb', 'yellow', 'butter'
      assign bg = '#e9d48a'
    when 'leopard', 'leo', 'animal'
      assign bg = 'radial-gradient(circle at 30% 30%, #c8a06a 25%, #6e4f2e 27%, #c8a06a 33%)'
    when 'multi', 'mehrfarbig', 'print', 'gemustert'
      assign bg = 'conic-gradient(#d9cdb8, #a8b39a, #c79f9d, #39598f, #d9cdb8)'
  endcase

  comment
    Teilwort-Erkennung für zusammengesetzte Namen ("Sea Salt Blue", "Blush Pink").
    Reihenfolge: spezifische Töne vor generischen Grundfarben.
  endcomment
  if bg == ''
    if v contains 'black' or v contains 'schwarz' or v contains 'ebony' or v contains 'onyx'
      assign bg = '#1d1c1a'
    elsif v contains 'charcoal' or v contains 'anthrazit' or v contains 'graphit'
      assign bg = '#46464a'
    elsif v contains 'white' or v contains 'weiß' or v contains 'weiss' or v contains 'ivory' or v contains 'albumin'
      assign bg = '#f7f6f3'
    elsif v contains 'cream' or v contains 'creme' or v contains 'vanilla' or v contains 'vanille' or v contains 'ecru'
      assign bg = '#efe9dd'
    elsif v contains 'teal' or v contains 'petrol'
      assign bg = '#2f5d62'
    elsif v contains 'navy' or v contains 'midnight' or v contains 'marine' or v contains 'mitternacht'
      assign bg = '#232c3d'
    elsif v contains 'emerald' or v contains 'smaragd'
      assign bg = '#14503c'
    elsif v contains 'dark green' or v contains 'ink green' or v contains 'forest' or v contains 'pine' or v contains 'tanne' or v contains 'dunkelgrün'
      assign bg = '#3d4f42'
    elsif v contains 'sage' or v contains 'salbei'
      assign bg = '#a8b39a'
    elsif v contains 'olive' or v contains 'oliv' or v contains 'khaki'
      assign bg = '#74785a'
    elsif v contains 'mint' or v contains 'minze' or v contains 'eukalyptus' or v contains 'eucalyptus'
      assign bg = '#cfe0d4'
    elsif v contains 'green' or v contains 'grün'
      assign bg = '#6f8a72'
    elsif v contains 'lavender gray' or v contains 'lavender grey' or v contains 'grey lavender' or v contains 'gray lavender'
      assign bg = '#b9b7be'
    elsif v contains 'lavender' or v contains 'lavendel' or v contains 'lilac' or v contains 'flieder'
      assign bg = '#c5bcd6'
    elsif v contains 'purple' or v contains 'violet' or v contains 'lila'
      assign bg = '#7c5fa8'
    elsif v contains 'plum' or v contains 'aubergine' or v contains 'pflaume'
      assign bg = '#5d4157'
    elsif v contains 'dusty rose' or v contains 'mauve' or v contains 'altrosa'
      assign bg = '#c79f9d'
    elsif v contains 'wine' or v contains 'burgundy' or v contains 'bordeaux' or v contains 'cherry' or v contains 'vine' or v contains 'wein'
      assign bg = '#6e2e35'
    elsif v contains 'raspberry' or v contains 'himbeer'
      assign bg = '#a23652'
    elsif v contains 'red' or v contains 'rot'
      assign bg = '#b03a2e'
    elsif v contains 'coral' or v contains 'peach' or v contains 'koralle' or v contains 'pfirsich' or v contains 'apricot'
      assign bg = '#e8a087'
    elsif v contains 'terracotta' or v contains 'terrakotta' or v contains 'clay' or v contains 'rust'
      assign bg = '#b3674c'
    elsif v contains 'pink' or v contains 'blush' or v contains 'rose' or v contains 'rosa'
      assign bg = '#e8c9c6'
    elsif v contains 'sea salt'
      assign bg = '#b7c9d3'
    elsif v contains 'sky' or v contains 'ice blue' or v contains 'air blue' or v contains 'powder' or v contains 'glacier' or v contains 'mist' or v contains 'dusty blue' or v contains 'light blue' or v contains 'baby blue' or v contains 'hellblau'
      assign bg = '#b9cfdd'
    elsif v contains 'steel' or v contains 'slate' or v contains 'denim' or v contains 'grey blue' or v contains 'gray blue' or v contains 'graublau'
      assign bg = '#33507a'
    elsif v contains 'blue' or v contains 'blau' or v contains 'cobalt' or v contains 'kobalt'
      assign bg = '#39598f'
    elsif v contains 'light grey' or v contains 'light gray' or v contains 'pearl' or v contains 'hellgrau' or v contains 'silver' or v contains 'silber'
      assign bg = '#c9c9c5'
    elsif v contains 'grey' or v contains 'gray' or v contains 'grau'
      assign bg = '#9a9a96'
    elsif v contains 'chocolate' or v contains 'espresso' or v contains 'brown' or v contains 'mocha' or v contains 'cocoa' or v contains 'kakao' or v contains 'braun' or v contains 'schoko' or v contains 'mokka'
      assign bg = '#5b4636'
    elsif v contains 'caramel' or v contains 'karamell' or v contains 'cognac' or v contains 'camel'
      assign bg = '#b4834f'
    elsif v contains 'taupe' or v contains 'greige'
      assign bg = '#b3a695'
    elsif v contains 'oat' or v contains 'sand' or v contains 'beige' or v contains 'hafer' or v contains 'stone'
      assign bg = '#d9cdb8'
    elsif v contains 'yellow' or v contains 'butter' or v contains 'lemon' or v contains 'gelb' or v contains 'senf' or v contains 'mustard' or v contains 'honey'
      assign bg = '#e9d48a'
    elsif v contains 'orange' or v contains 'tangerine'
      assign bg = '#d97b3f'
    elsif v contains 'gold'
      assign bg = '#c9a96a'
    endif
  endif

  unless bg != ''
    assign bg = '#cbc5ba'
  endunless
-%}{{ bg }}
