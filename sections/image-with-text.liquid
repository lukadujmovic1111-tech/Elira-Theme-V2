<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="iwt{% if section.settings.layout == 'reverse' %} iwt--reverse{% endif %}">
      <div class="iwt__media">
        {%- if section.settings.image -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            widths: '550, 800, 1000, 1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            alt: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="iwt__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--outline">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Bild mit Text",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Empfohlen: 1200 × 1500 px"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Anordnung",
      "options": [
        { "value": "default", "label": "Bild links" },
        { "value": "reverse", "label": "Bild rechts" }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Unsere Philosophie"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Entworfen für dein Studio. Gemacht für deinen Alltag."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Elira steht für Pilates-Wear und Studio-Essentials, die Funktion und Ästhetik vereinen: weiche, formstabile Stoffe, durchdachte Schnitte und Farben, die zusammenpassen – vom Reformer bis zum Café danach.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button-Text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button-Link"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Dunkel" }
      ],
      "default": "sand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Bild mit Text"
    }
  ]
}
{% endschema %}
