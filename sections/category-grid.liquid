<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head{% if section.settings.center_heading %} section-head--center{% endif %}">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="category-grid" style="--cat-cols: {{ section.blocks.size | at_least: 2 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign cat_url = block.settings.link
          if cat_url == blank and block.settings.collection != blank
            assign cat_url = block.settings.collection.url
          endif
          assign cat_image = block.settings.image
          if cat_image == blank and block.settings.collection.image
            assign cat_image = block.settings.collection.image
          endif
          assign cat_label = block.settings.label
          if cat_label == blank and block.settings.collection != blank
            assign cat_label = block.settings.collection.title
          endif
          if cat_label == blank
            assign cat_label = 'onboarding.collection_title' | t
          endif
        -%}
        <a href="{{ cat_url | default: '#' }}" class="category-card" {{ block.shopify_attributes }}>
          <div class="category-card__media">
            {%- if cat_image -%}
              {{ cat_image | image_url: width: 900 | image_tag:
                widths: '360, 540, 720, 900',
                sizes: '(min-width: 990px) 33vw, 50vw',
                loading: 'lazy',
                alt: cat_label
              }}
            {%- else -%}
              {{ 'collection-2' | placeholder_svg_tag }}
            {%- endif -%}
          </div>
          <span class="category-card__label">
            {{ cat_label }}
            {% render 'icon', icon: 'arrow-right' %}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kategorie-Grid",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Shoppe nach Kategorie"
    },
    {
      "type": "checkbox",
      "id": "center_heading",
      "label": "Überschrift zentrieren",
      "default": false
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "limit": 4,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild (überschreibt Kollektionsbild)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Beschriftung (überschreibt Titel)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (überschreibt Kollektion)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategorie-Grid",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
