{%- comment -%}
  Wird ausschließlich über die Section Rendering API geladen
  (Such-Overlay im Header). Kein statisches Rendering.
{%- endcomment -%}
<div id="PredictiveSearchResults">
  {%- if predictive_search.performed -%}
    {%- if predictive_search.resources.products.size > 0 -%}
      <p class="eyebrow" style="margin-bottom: 1rem;">{{ 'general.search.products' | t }}</p>
      <div class="predictive-grid">
        {%- for product in predictive_search.resources.products -%}
          <a href="{{ product.url }}" class="predictive-item">
            <div class="predictive-item__media">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 128 | image_tag: loading: 'lazy', alt: product.title }}
              {%- else -%}
                {{ 'product-apparel-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div>
              <p class="predictive-item__title">{{ product.title }}</p>
              <p class="predictive-item__price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      <div class="search-overlay__footer">
        <a class="link-arrow" href="{{ routes.search_url }}?q={{ predictive_search.terms | url_param_escape }}">
          {{ 'general.search.view_all' | t }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      </div>
    {%- else -%}
      <p class="predictive-empty">{{ 'general.search.no_results' | t: terms: predictive_search.terms }}</p>
    {%- endif -%}
  {%- endif -%}
</div>
