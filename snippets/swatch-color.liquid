{%- comment -%}
  Gibt einen CSS-Farbwert für einen Farbnamen zurück.
  Verwendung: {% render 'swatch-color', value: 'Sage Green' %}
{%- endcomment -%}
{%- liquid
  assign key = value | downcase | strip
  assign map = 'deep black:#161616,black:#161616,schwarz:#161616,white:#FFFFFF,weiß:#FFFFFF,weiss:#FFFFFF,creme:#F2E9D8,cream:#F2E9D8,butter cream:#F2E4BE,beige:#D9CBB4,sand:#D8C9AE,ivory:#F7F1E6,grau:#9A9A9A,grey:#9A9A9A,gray:#9A9A9A,space grey:#6E6E73,anthrazit:#3C3C3F,navy:#26344A,navy blue:#26344A,dunkelblau:#26344A,steel blue:#6E8CA8,sea salt blue:#B7CBD3,light blue:#A8C8E0,himmelblau:#A4CBE8,hellblau:#A4CBE8,blau:#3C5BA0,blue:#3C5BA0,denim:#5876A3,mint:#BCE2D0,salbei:#9CAE94,sage:#9CAE94,sage green:#9CAE94,olive:#7A7A52,oliv:#7A7A52,dark green:#2F4A3C,dunkelgrün:#2F4A3C,grün:#4E7A52,green:#4E7A52,dark emerald:#1F4D3E,emerald:#2E6B57,khaki:#8A8262,lavendel:#C2B3E2,lavender:#C2B3E2,flieder:#C9B6DC,lilac:#C9B6DC,lila:#A07CC5,purple:#8E6FAE,violett:#8E6FAE,dark plum:#4A2C40,plum:#6A3F5C,dark grape:#46303F,aubergine:#46303F,mauve:#B68CA4,rosa:#F3BECB,rose:#E8A8B8,pink:#E68FB0,soft pink:#F1CED7,blush pink:#EFC2CA,ballet pink:#F4C8CF,dusty pink:#D7A6B0,altrosa:#D7A6B0,hot pink:#E0518F,fuchsia:#C2348B,rot:#B03A30,red:#B03A30,metallic red:#8E2F2F,bordeaux:#6B2734,burgundy:#6B2734,weinrot:#6B2734,terracotta:#C26E51,coral:#E98271,apricot:#F2BD9C,peach:#F4C5A4,orange:#E08A3C,senf:#D2A33C,mustard:#D2A33C,gelb:#E9D26E,yellow:#E9D26E,vanille:#F1E4B8,gold:#C9A85C,silber:#C7C7CC,silver:#C7C7CC,braun:#7A5B43,brown:#7A5B43,chocolate:#5A4032,schoko:#5A4032,mokka:#6E5546,taupe:#A99685,cappuccino:#B89B7E,pecan:#8A6248,caramel:#B57F4F,nude:#E3C5AC' | split: ','
  assign result = '#CFC8BE'
  for pair in map
    assign parts = pair | split: ':'
    if parts[0] == key
      assign result = parts[1]
      break
    endif
  endfor
-%}{{ result }}
