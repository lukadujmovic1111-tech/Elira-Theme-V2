<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container container--narrow">
    <div class="newsletter-section__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="newsletter-section__sub">{{ section.settings.text }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'SectionNewsletter' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" role="status">{{ 'general.newsletter.success' | t }}</p>
        {%- elsif form.errors -%}
          <p class="form-status form-status--error" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <div class="newsletter-form" style="margin-inline: auto;">
          <input
            type="email"
            name="contact[email]"
            value="{{ form.email }}"
            placeholder="{{ 'general.newsletter.label' | t }}"
            aria-label="{{ 'general.newsletter.label' | t }}"
            autocomplete="email"
            required
          >
          <button type="submit">
            {{ 'general.newsletter.button' | t }}
            {% render 'icon', icon: 'arrow-right' %}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Newsletter"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "10 % auf deine erste Bestellung"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Melde dich an und erhalte Zugang zu neuen Kollektionen, Studio-Tipps und exklusiven Angeboten – direkt in dein Postfach."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Dunkel" }
      ],
      "default": "ink"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
