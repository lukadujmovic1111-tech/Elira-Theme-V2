<div class="scheme-{{ section.settings.scheme }}">
  <div class="marquee" style="--marquee-speed: {{ section.settings.speed }}s;">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <span class="marquee__item" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <span {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
            <span class="marquee__sep" aria-hidden="true"></span>
          {%- endfor -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Laufband",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Dunkel" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "s",
      "label": "Geschwindigkeit (Dauer)",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Eintrag",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Von Frauen. Für Frauen."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Laufband",
      "blocks": [
        { "type": "item", "settings": { "text": "Von Frauen. Für Frauen." } },
        { "type": "item", "settings": { "text": "Bewegung, die bleibt" } },
        { "type": "item", "settings": { "text": "Kostenloser Versand ab 75 €" } },
        { "type": "item", "settings": { "text": "Designed in Germany" } }
      ]
    }
  ]
}
{% endschema %}
