{%- if section.blocks.size > 0 -%}
  <announcement-rotator class="announcement" data-interval="{{ section.settings.interval | times: 1000 }}" role="region" aria-label="Ankündigungen">
    <div class="announcement__track">
      {%- for block in section.blocks -%}
        <p class="announcement__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
          {%- else -%}
            {{ block.settings.text | escape }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </announcement-rotator>
{%- endif -%}

{% schema %}
{
  "name": "Announcement-Bar",
  "tag": "div",
  "settings": [
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Wechsel-Intervall",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Ankündigung",
      "limit": 5,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Kostenloser Versand ab 75 €"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement-Bar",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Kostenloser Versand ab 75 €" } },
        { "type": "announcement", "settings": { "text": "2–4 Werktage Lieferzeit" } },
        { "type": "announcement", "settings": { "text": "30 Tage Geld-zurück-Garantie" } }
      ]
    }
  ]
}
{% endschema %}
