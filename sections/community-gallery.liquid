<section class="section community-gallery">
  <div class="container container--wide">
    <div class="section-head section-head--center" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="section-sub">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- liquid
    assign track_classes = 'community-gallery__track'
    if section.settings.direction == 'ltr'
      assign track_classes = track_classes | append: ' community-gallery__track--reverse'
    endif
    if section.settings.pause_on_hover
      assign track_classes = track_classes | append: ' community-gallery__track--pause'
    endif
  -%}

  <div class="community-gallery__marquee" data-reveal data-community-slider>
    <div class="{{ track_classes }}" data-community-track style="--marquee-duration: {{ section.settings.speed | default: 40 }}s;">
      <div class="community-gallery__group" data-community-group>
        {%- for block in section.blocks -%}
          {%- liquid
            assign pidx = forloop.index0 | modulo: 4 | plus: 1
            assign tile_url = block.settings.link
            if tile_url == blank and settings.social_instagram != blank
              assign tile_url = settings.social_instagram
            endif
          -%}
          <a href="{{ tile_url | default: '#' }}" class="community-tile" {{ block.shopify_attributes }}{% if block.settings.link == blank %} target="_blank" rel="noopener"{% endif %}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 800
                | image_tag:
                  widths: '300, 500, 800',
                  sizes: '(min-width: 990px) 18vw, 60vw',
                  loading: 'lazy' }}
            {%- else -%}
              {{ 'collection-apparel-' | append: pidx | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <span class="community-tile__overlay">
              {% render 'icon', name: 'instagram', size: 22 %}
              {%- if block.settings.caption != blank -%}
                <span class="community-tile__caption">{{ block.settings.caption }}</span>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if section.settings.handle != blank -%}
    <div class="community-gallery__cta" data-reveal>
      <a href="{{ settings.social_instagram | default: '#' }}" class="btn btn--secondary" target="_blank" rel="noopener">
        {% render 'icon', name: 'instagram', size: 16 %}
        {{ section.settings.handle }}
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.community-gallery__marquee {
  position: relative;
  margin-top: 2.5rem;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
}
.community-gallery__track {
  display: flex;
  width: max-content;
  animation: community-scroll var(--marquee-duration, 40s) linear infinite;
}
.community-gallery__track--reverse { animation-direction: reverse; }
.community-gallery__track--pause:hover { animation-play-state: paused; }
.community-gallery__track--paused { animation-play-state: paused; }
.community-gallery__group { display: flex; }
.community-gallery__group > .community-tile {
  flex: 0 0 auto;
  width: 60vw;
  max-width: 340px;
  margin-right: 1rem;
  aspect-ratio: 1 / 1;
}
.community-gallery__group > .community-tile img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
@media (min-width: 750px) {
  .community-gallery__group > .community-tile { width: 32vw; }
}
@media (min-width: 990px) {
  .community-gallery__group > .community-tile { width: 18vw; max-width: 280px; }
}
@keyframes community-scroll {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}
@media (prefers-reduced-motion: reduce) {
  .community-gallery__track { animation: none; }
}
{% endstylesheet %}

<script>
  (function () {
    function initMarquee(slider) {
      if (slider.dataset.communityReady === 'true') return;
      slider.dataset.communityReady = 'true';
      var track = slider.querySelector('[data-community-track]');
      var group = slider.querySelector('[data-community-group]');
      if (!track || !group) return;
      var clone = group.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.removeAttribute('data-community-group');
      clone.querySelectorAll('[data-shopify-editor-block]').forEach(function (el) { el.removeAttribute('data-shopify-editor-block'); });
      clone.querySelectorAll('[id]').forEach(function (el) { el.removeAttribute('id'); });
      track.appendChild(clone);
      if (window.Shopify && window.Shopify.designMode) {
        track.classList.add('community-gallery__track--paused');
      }
    }
    function initAll() {
      document.querySelectorAll('[data-community-slider]').forEach(initMarquee);
    }
    if (document.readyState !== 'loading') initAll();
    else document.addEventListener('DOMContentLoaded', initAll);
    document.addEventListener('shopify:section:load', initAll);
  })();
</script>

{% schema %}
{
  "name": "Community / Instagram",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "#EliraMoves"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Getragen von unserer Community"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Zeig uns deinen Flow und werde Teil der Elira-Community."
    },
    {
      "type": "header",
      "content": "Bewegung"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Laufrichtung",
      "options": [
        { "value": "ltr", "label": "Links nach rechts" },
        { "value": "rtl", "label": "Rechts nach links" }
      ],
      "default": "ltr"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Geschwindigkeit",
      "info": "Sekunden pro Durchlauf – höher = langsamer",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Bei Mouseover pausieren",
      "default": true
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Button-Text",
      "default": "@elira folgen"
    }
  ],
  "max_blocks": 24,
  "blocks": [
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild",
          "info": "Empfohlen: quadratisch, 800 × 800 px"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional, sonst Instagram-Profil)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Community / Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
