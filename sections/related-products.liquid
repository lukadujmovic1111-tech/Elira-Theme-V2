<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <related-products data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <div class="section-head">
          <div>
            {%- if section.settings.heading != blank -%}
              <h2 class="h2">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </div>
        </div>
        <div class="product-grid product-grid--4">
          {%- for rec_product in recommendations.products -%}
            {% render 'product-card', card_product: rec_product %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </related-products>
  </div>
</div>

{% schema %}
{
  "name": "Produktempfehlungen",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Das könnte dir gefallen"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Anzahl Produkte",
      "default": 4
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 88
    }
  ]
}
{% endschema %}
