<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container container--narrow">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <span class="eyebrow">{{ section.settings.eyebrow }}</span>
          {%- endif -%}
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="accordion">
      {%- for block in section.blocks -%}
        <details class="accordion__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary class="accordion__summary">
            {{ block.settings.question }}
            {% render 'icon', icon: 'chevron-down' %}
          </summary>
          <div class="accordion__content rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FAQ / Akkordeon",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Häufige Fragen"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Erstes Element geöffnet",
      "default": false
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Frage",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Frage",
          "default": "Wie lange dauert der Versand?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Antwort",
          "default": "<p>Deine Bestellung ist in der Regel innerhalb von 2–4 Werktagen bei dir. Ab 75 € liefern wir versandkostenfrei.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ / Akkordeon",
      "blocks": [
        { "type": "item" },
        {
          "type": "item",
          "settings": {
            "question": "Wie fällt die Größe aus?",
            "answer": "<p>Unsere Outfits fallen normal aus und sind figurbetont geschnitten. Zwischen zwei Größen? Wähle die größere für einen entspannteren Sitz.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "question": "Kann ich meine Bestellung zurückgeben?",
            "answer": "<p>Ja – du hast 30 Tage Zeit, deine unbenutzten Artikel zurückzusenden. Die Rückerstattung erfolgt auf dein ursprüngliches Zahlungsmittel.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
