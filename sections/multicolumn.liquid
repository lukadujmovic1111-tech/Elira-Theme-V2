<div class="section scheme-{{ section.settings.scheme }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head section-head--center">
        <div>
          <h2 class="h2">{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="usp-grid" style="--usp-cols: {{ section.blocks.size | at_least: 2 | at_most: 4 }};">
      {%- for block in section.blocks -%}
        <div class="usp" {{ block.shopify_attributes }}>
          {% render 'icon', icon: block.settings.icon %}
          {%- if block.settings.title != blank -%}
            <h3 class="usp__title h5">{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="usp__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "USP-Leiste",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "Farbschema",
      "options": [
        { "value": "default", "label": "Hell" },
        { "value": "sand", "label": "Sand" },
        { "value": "ink", "label": "Dunkel" }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Spalte",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Versand" },
            { "value": "return", "label": "Rückgabe" },
            { "value": "shield", "label": "Sicherheit" },
            { "value": "sparkle", "label": "Qualität" },
            { "value": "heart", "label": "Herz" },
            { "value": "mail", "label": "Kontakt" },
            { "value": "star", "label": "Stern" },
            { "value": "check", "label": "Haken" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kostenloser Versand"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Ab 75 € Bestellwert – in 2–4 Werktagen bei dir."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "USP-Leiste",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "icon": "truck",
            "title": "Kostenloser Versand",
            "text": "Ab 75 € Bestellwert – in 2–4 Werktagen bei dir."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "return",
            "title": "30 Tage Rückgabe",
            "text": "Nicht verliebt? Kostenlose Rücksendung, ohne Wenn und Aber."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "shield",
            "title": "Sichere Zahlung",
            "text": "Apple Pay, PayPal, Klarna, Kreditkarte – SSL-verschlüsselt."
          }
        },
        {
          "type": "column",
          "settings": {
            "icon": "sparkle",
            "title": "Studio-Qualität",
            "text": "Formstabile Stoffe, entwickelt mit Pilates-Trainerinnen."
          }
        }
      ]
    }
  ]
}
{% endschema %}
